PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dbo:  <http://dbpedia.org/ontology/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
# Builds cv-dbpedia-import.owl : DBpedia types, class hierarchy, labels,
# short descriptions, Wikipedia pages, images and place relations for every
# DBpedia resource linked (owl:sameAs) from cv-ontology.owl.
CONSTRUCT {
  <https://www.prashanthshenoy.com/cv-dbpedia-import.owl> a owl:Ontology ;
      rdfs:label "DBpedia import for the CV ontology of Prashanth Shenoy"@en .
  dbo:country a owl:ObjectProperty . dbo:city a owl:ObjectProperty .
  dbo:state a owl:ObjectProperty .   dbo:isPartOf a owl:ObjectProperty .
  dbo:populationTotal a owl:DatatypeProperty .
  dbo:thumbnail a owl:AnnotationProperty . foaf:isPrimaryTopicOf a owl:AnnotationProperty .
  ?s a owl:NamedIndividual , ?t . ?t a owl:Class .
  ?c rdfs:subClassOf ?u . ?u a owl:Class .
  ?s rdfs:label ?label . ?s rdfs:comment ?comment .
  ?s dbo:thumbnail ?img . ?s foaf:isPrimaryTopicOf ?wiki .
  ?s ?rel ?o . ?s dbo:populationTotal ?pop .
}
WHERE {
  VALUES ?s { <http://dbpedia.org/resource/AI_literacy> <http://dbpedia.org/resource/Arizona> <http://dbpedia.org/resource/Artificial_Intelligence_Act> <http://dbpedia.org/resource/Association_for_Computing_Machinery> <http://dbpedia.org/resource/B.M.S._College_of_Engineering> <http://dbpedia.org/resource/Bachelor_of_Engineering> <http://dbpedia.org/resource/Bali> <http://dbpedia.org/resource/Bengaluru> <http://dbpedia.org/resource/Brazil> <http://dbpedia.org/resource/Cambridge_Assessment_English> <http://dbpedia.org/resource/Central_Board_of_Secondary_Education> <http://dbpedia.org/resource/Central_Finland> <http://dbpedia.org/resource/Certificate_in_Teaching_English_to_Speakers_of_Other_Languages> <http://dbpedia.org/resource/Chennai> <http://dbpedia.org/resource/Doctor_of_Philosophy> <http://dbpedia.org/resource/Dublin> <http://dbpedia.org/resource/Educational_technology> <http://dbpedia.org/resource/English_language> <http://dbpedia.org/resource/Explainable_artificial_intelligence> <http://dbpedia.org/resource/Finland> <http://dbpedia.org/resource/Finnish_language> <http://dbpedia.org/resource/Generative_artificial_intelligence> <http://dbpedia.org/resource/Government_of_Karnataka> <http://dbpedia.org/resource/Hawaii> <http://dbpedia.org/resource/Hawaii_International_Conference_on_System_Sciences> <http://dbpedia.org/resource/Hindi> <http://dbpedia.org/resource/Human–computer_interaction> <http://dbpedia.org/resource/IIT_Bombay> <http://dbpedia.org/resource/IIT_Madras> <http://dbpedia.org/resource/India> <http://dbpedia.org/resource/Indonesia> <http://dbpedia.org/resource/Information_technology> <http://dbpedia.org/resource/Institute_of_Electrical_and_Electronics_Engineers> <http://dbpedia.org/resource/Jyväskylä> <http://dbpedia.org/resource/Karnataka> <http://dbpedia.org/resource/LaTeX> <http://dbpedia.org/resource/Learning_analytics> <http://dbpedia.org/resource/Lisbon> <http://dbpedia.org/resource/Machine_learning> <http://dbpedia.org/resource/Master_of_Science> <http://dbpedia.org/resource/Meta-analysis> <http://dbpedia.org/resource/Ministry_of_Education_(India)> <http://dbpedia.org/resource/Mumbai> <http://dbpedia.org/resource/NITI_Aayog> <http://dbpedia.org/resource/OECD> <http://dbpedia.org/resource/PayPal> <http://dbpedia.org/resource/Philippines> <http://dbpedia.org/resource/Porto> <http://dbpedia.org/resource/Portugal> <http://dbpedia.org/resource/Preferred_Reporting_Items_for_Systematic_Reviews_and_Meta-Analyses> <http://dbpedia.org/resource/Professional_development> <http://dbpedia.org/resource/Python_(programming_language)> <http://dbpedia.org/resource/Republic_of_Ireland> <http://dbpedia.org/resource/Research_Council_of_Finland> <http://dbpedia.org/resource/Rio_de_Janeiro> <http://dbpedia.org/resource/Scikit-learn> <http://dbpedia.org/resource/Springer_Nature> <http://dbpedia.org/resource/Structural_equation_modeling> <http://dbpedia.org/resource/Systematic_review> <http://dbpedia.org/resource/Taylor_&_Francis> <http://dbpedia.org/resource/Teacher_education> <http://dbpedia.org/resource/Technology_acceptance_model> <http://dbpedia.org/resource/TensorFlow> <http://dbpedia.org/resource/Thematic_analysis> <http://dbpedia.org/resource/Tucson,_Arizona> <http://dbpedia.org/resource/UNESCO> <http://dbpedia.org/resource/United_States> <http://dbpedia.org/resource/Universidade_Aberta> <http://dbpedia.org/resource/University_of_Arizona> <http://dbpedia.org/resource/University_of_Jyväskylä> }
  { ?s a ?t . FILTER(STRSTARTS(STR(?t), STR(dbo:))) }
  UNION
  { ?s a ?t0 . FILTER(STRSTARTS(STR(?t0), STR(dbo:)))
     ?t0 rdfs:subClassOf* ?c . ?c rdfs:subClassOf ?u .
     FILTER(STRSTARTS(STR(?c), STR(dbo:)) && STRSTARTS(STR(?u), STR(dbo:))) }
  UNION
  { ?s rdfs:label ?label . FILTER(LANG(?label) = "en") }
  UNION
  { ?s rdfs:comment ?comment . FILTER(LANG(?comment) = "en") }
  UNION
  { ?s dbo:thumbnail ?img }
  UNION
  { ?s foaf:isPrimaryTopicOf ?wiki }
  UNION
  { VALUES ?rel { dbo:country dbo:city dbo:state dbo:isPartOf }
     VALUES ?o { <http://dbpedia.org/resource/AI_literacy> <http://dbpedia.org/resource/Arizona> <http://dbpedia.org/resource/Artificial_Intelligence_Act> <http://dbpedia.org/resource/Association_for_Computing_Machinery> <http://dbpedia.org/resource/B.M.S._College_of_Engineering> <http://dbpedia.org/resource/Bachelor_of_Engineering> <http://dbpedia.org/resource/Bali> <http://dbpedia.org/resource/Bengaluru> <http://dbpedia.org/resource/Brazil> <http://dbpedia.org/resource/Cambridge_Assessment_English> <http://dbpedia.org/resource/Central_Board_of_Secondary_Education> <http://dbpedia.org/resource/Central_Finland> <http://dbpedia.org/resource/Certificate_in_Teaching_English_to_Speakers_of_Other_Languages> <http://dbpedia.org/resource/Chennai> <http://dbpedia.org/resource/Doctor_of_Philosophy> <http://dbpedia.org/resource/Dublin> <http://dbpedia.org/resource/Educational_technology> <http://dbpedia.org/resource/English_language> <http://dbpedia.org/resource/Explainable_artificial_intelligence> <http://dbpedia.org/resource/Finland> <http://dbpedia.org/resource/Finnish_language> <http://dbpedia.org/resource/Generative_artificial_intelligence> <http://dbpedia.org/resource/Government_of_Karnataka> <http://dbpedia.org/resource/Hawaii> <http://dbpedia.org/resource/Hawaii_International_Conference_on_System_Sciences> <http://dbpedia.org/resource/Hindi> <http://dbpedia.org/resource/Human–computer_interaction> <http://dbpedia.org/resource/IIT_Bombay> <http://dbpedia.org/resource/IIT_Madras> <http://dbpedia.org/resource/India> <http://dbpedia.org/resource/Indonesia> <http://dbpedia.org/resource/Information_technology> <http://dbpedia.org/resource/Institute_of_Electrical_and_Electronics_Engineers> <http://dbpedia.org/resource/Jyväskylä> <http://dbpedia.org/resource/Karnataka> <http://dbpedia.org/resource/LaTeX> <http://dbpedia.org/resource/Learning_analytics> <http://dbpedia.org/resource/Lisbon> <http://dbpedia.org/resource/Machine_learning> <http://dbpedia.org/resource/Master_of_Science> <http://dbpedia.org/resource/Meta-analysis> <http://dbpedia.org/resource/Ministry_of_Education_(India)> <http://dbpedia.org/resource/Mumbai> <http://dbpedia.org/resource/NITI_Aayog> <http://dbpedia.org/resource/OECD> <http://dbpedia.org/resource/PayPal> <http://dbpedia.org/resource/Philippines> <http://dbpedia.org/resource/Porto> <http://dbpedia.org/resource/Portugal> <http://dbpedia.org/resource/Preferred_Reporting_Items_for_Systematic_Reviews_and_Meta-Analyses> <http://dbpedia.org/resource/Professional_development> <http://dbpedia.org/resource/Python_(programming_language)> <http://dbpedia.org/resource/Republic_of_Ireland> <http://dbpedia.org/resource/Research_Council_of_Finland> <http://dbpedia.org/resource/Rio_de_Janeiro> <http://dbpedia.org/resource/Scikit-learn> <http://dbpedia.org/resource/Springer_Nature> <http://dbpedia.org/resource/Structural_equation_modeling> <http://dbpedia.org/resource/Systematic_review> <http://dbpedia.org/resource/Taylor_&_Francis> <http://dbpedia.org/resource/Teacher_education> <http://dbpedia.org/resource/Technology_acceptance_model> <http://dbpedia.org/resource/TensorFlow> <http://dbpedia.org/resource/Thematic_analysis> <http://dbpedia.org/resource/Tucson,_Arizona> <http://dbpedia.org/resource/UNESCO> <http://dbpedia.org/resource/United_States> <http://dbpedia.org/resource/Universidade_Aberta> <http://dbpedia.org/resource/University_of_Arizona> <http://dbpedia.org/resource/University_of_Jyväskylä> }
     ?s ?rel ?o }
  UNION
  { ?s dbo:populationTotal ?pop . FILTER(DATATYPE(?pop) = <http://www.w3.org/2001/XMLSchema#nonNegativeInteger>) }
}