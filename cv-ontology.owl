    <!-- https://www.prashanthshenoy.com/cv-ontology.owl#AcademicDegree -->

    <owl:Class rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#AcademicDegree">
        <rdfs:subClassOf rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#Qualification"/>
        <owl:disjointWith rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#Certificate"/>
        <rdfs:label xml:lang="en">Academic degree</rdfs:label>
    </owl:Class>
    


    <!-- https://www.prashanthshenoy.com/cv-ontology.owl#AcceptedPublication -->

    <owl:Class rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#AcceptedPublication">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
