                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#hasLanguageProficiency"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#LanguageProficiency"/>
