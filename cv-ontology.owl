                        <owl:hasValue rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#UnderReview"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Publication under review</rdfs:label>
    </owl:Class>
    


