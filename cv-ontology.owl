                    <rdf:Description rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#Published"/>
                    <rdf:Description rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#UnderReview"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.prashanthshenoy.com/cv-ontology.owl#Abstraction"/>
        <rdfs:label xml:lang="en">Publication status</rdfs:label>
    </owl:Class>
    


    <!-- https://www.prashanthshenoy.com/cv-ontology.owl#PublicationUnderReview -->

    <owl:Class rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#PublicationUnderReview">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl#Publication"/>
                    <owl:Restriction>
