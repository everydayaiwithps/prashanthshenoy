<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.prashanthshenoy.com/cv-ontology.owl#"
     xml:base="https://www.prashanthshenoy.com/cv-ontology.owl"
     xmlns:cv="https://www.prashanthshenoy.com/cv-ontology.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:dbo="http://dbpedia.org/ontology/">
    <owl:Ontology rdf:about="https://www.prashanthshenoy.com/cv-ontology.owl">
        <owl:imports rdf:resource="https://www.prashanthshenoy.com/cv-dbpedia-import.owl"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</dcterms:created>
        <dcterms:creator>Prashanth Shenoy</dcterms:creator>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:source rdf:resource="https://www.prashanthshenoy.com/cv.html"/>
        <rdfs:comment xml:lang="en">OWL ontology and RDF semantic annotation of the academic CV of Prashanth Shenoy (doctoral researcher, University of Jyvaskyla). Built for ITKS5440 Semantic Web and Linked Data, Fall 2026. The ontology describes persons, organisations, places, qualifications, employment records, publications, venues, research topics, methods, skills, artefacts, funding and web media mentioned in a researcher CV, and links individuals to DBpedia through owl:sameAs. A companion ontology (cv-dbpedia-import.owl), generated with SPARQL CONSTRUCT queries on the DBpedia endpoint, is imported to merge DBpedia types, class hierarchy and place relations.</rdfs:comment>
        <rdfs:label xml:lang="en">CV Ontology of Prashanth Shenoy</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


